{
  "name": "heatmap-app",
  "version": "4.0.0",
  "description": "Heatmap: enter a link (website, local HTML file or Figma prototype) and record where people look (webcam), move, click and scroll, with heatmaps, replay and charts.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "docx": "^9.8.1",
    "webgazer": "3.5.3"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "Heatmap",
  "author": "Heatmap",
  "build": {
    "appId": "com.heatmap.desktop",
    "productName": "Heatmap",
    "files": [
      "server.js",
      "public/**",
      "electron/**",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Heatmap uses the webcam to estimate where you look on the page being tested. Video never leaves this Mac.",
        "NSMicrophoneUsageDescription": "Heatmap records the microphone during a session (when you turn on audio recording) so it can be transcribed. Audio is stored only on this Mac."
      },
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Heatmap ${version}",
      "artifactName": "Heatmap-${version}-${arch}.dmg"
    },
    "extraResources": [
      {
        "from": "node_modules/webgazer/dist",
        "to": "webgazer",
        "filter": [
          "**/*",
          "!*.map"
        ]
      },
      {
        "from": "node_modules/@huggingface/transformers/dist",
        "to": "transformers",
        "filter": [
          "transformers.min.js"
        ]
      },
      {
        "from": "node_modules/onnxruntime-web/dist",
        "to": "ort",
        "filter": [
          "ort-wasm-simd-threaded.asyncify.mjs",
          "ort-wasm-simd-threaded.asyncify.wasm",
          "ort-wasm-simd-threaded.jsep.mjs",
          "ort-wasm-simd-threaded.jsep.wasm"
        ]
      },
      {
        "from": "node_modules/docx/dist",
        "to": "docx",
        "filter": [
          "index.cjs"
        ]
      }
    ]
  }
}
